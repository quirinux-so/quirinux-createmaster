function _quit() {

	# Function to exit the program
    
    clear
    exit 0
}

function _rootcheck() {	
	
	# Check if the user has administrative privileges
	
	if [ "$EUID" -ne 0  ]; then
		echo ''
		echo "Este script debe ejecutarse con permisos de root."
		echo 'Puedes intentarlo con "sudo" tuusuario, "sudo su" o "su root".'
		echo ''
		exit 1
	fi	
}

function _internet() {
	
	# Check if there is an internet connection

	if ! ping -c 1 google.com &> /dev/null; then
		echo "ERROR: Este programa require conexión a internet."
		exit 1   # BUG CORREGIDO: era "xit 1"
	fi        
}

function _update() {
    
	# Detect package system and update the list
    
    if command -v apt-get &>/dev/null; then
        apt-get update && apt-get upgrade -y
    elif command -v dnf &>/dev/null; then
        dnf update -y
    elif command -v yum &>/dev/null; then
        yum update -y
    else
        echo "No se encontró un gestor de paquetes compatible" >&2
        exit 1
    fi    
}

function _depends() {
	
	# Install dependencies
	
    TMP_DIR="/tmp/repo"
    mkdir -p "$TMP_DIR"
    
    get_latest_version() {
        local location=$1
        
		# Check whether the packages to download are local or remote
        
        if [[ $location =~ ^https?:// ]]; then
            wget -qO- "$location" | grep -oP "[a-zA-Z0-9._-]+\.(deb|rpm)" | sort -V | tail -n 1
        else
            find "$location" -type f \( -name "*.deb" -o -name "*.rpm" \) | sort -V | tail -n 1 | xargs -I{} basename {}
        fi
    }
    
    if [ ! -e /opt/createmaster/verif/ok-dependencias ]; then
        _update
        
		# Dependencies are defined here

        BASE_PACKAGES=(wget git spice-vdagent dialog)
        
		# Install dependency packages using the distro's package manager

        if command -v apt &>/dev/null; then
            for pkg in "${BASE_PACKAGES[@]}"; do
                if ! dpkg -l | grep -qw "$pkg"; then
                    apt install -y "$pkg"
                fi
            done
        elif command -v dnf &>/dev/null; then
            for pkg in "${BASE_PACKAGES[@]}"; do
                if ! dnf list installed "$pkg" &>/dev/null; then
                    dnf install -y "$pkg"
                fi
            done
        elif command -v yum &>/dev/null; then
            for pkg in "${BASE_PACKAGES[@]}"; do
                if ! yum list installed "$pkg" &>/dev/null; then
                    yum install -y "$pkg"
                fi
            done
        else
            echo "No se encontró un gestor de paquetes compatible" >&2
            exit 1
        fi
        
		# Install additional dependencies
		
        for location in "${DISTRO_DEPENDS_LOCATION[@]}"; do
            latest_package=$(get_latest_version "$location")
            
            if [[ -n "$latest_package" ]]; then
                if [[ $location =~ ^https?:// ]]; then
                    wget --no-check-certificate "$location$latest_package" -O "$TMP_DIR/$latest_package"
                else
                    cp "$location/$latest_package" "$TMP_DIR/"
                fi
                
				# Install downloaded packages
				
                if [[ "$latest_package" == *.deb ]]; then
                    apt install -y "$TMP_DIR/$latest_package"
                elif [[ "$latest_package" == *.rpm ]]; then
                    if command -v dnf &>/dev/null; then
                        dnf install -y "$TMP_DIR/$latest_package"
                    elif command -v yum &>/dev/null; then
                        yum install -y "$TMP_DIR/$latest_package"
                    fi
                fi
            fi
        done
        
		# Create marker file
		
        mkdir -p /opt/createmaster/verif/
        touch /opt/createmaster/verif/ok-dependencias
    fi
}

function _lang() {	
	
	# Generate and activate the system locales required by createmaster.
	# Creates a marker file at /opt/createmaster/verif/ok-lang on success
	# so that locale generation is only performed once.
	#
	# The default system locale is es_ES.UTF-8 unless overridden in
	# /opt/createmaster/var_distro with:
	#
	#   DISTRO_LANG_DEFAULT="pt_PT.UTF-8"   # or any other supported locale
	#
	# Locales always generated regardless of the default:
	#   en_US, fr_FR, de_DE, it_IT, gl_ES, pt_PT
	# Plus whichever locale DISTRO_LANG_DEFAULT resolves to.

	# Default language
	# MULTI-DISTRO: can be overridden in var_distro with DISTRO_LANG_DEFAULT

    LANG_PREDET="${DISTRO_LANG_DEFAULT:-es_ES.UTF-8}"
    
	# Verify language marker
	
	if [ ! -e /opt/createmaster/verif/ok-lang ]; then

		# BUG CORREGIDO: se crea el directorio antes de intentar escribir el marcador
		mkdir -p /opt/createmaster/verif/
	
		if [ ! -e /usr/share/locale/locale.alias ]; then
			touch /usr/share/locale/locale.alias
		fi
    
		idiomas=("en_US.UTF-8" "fr_FR.UTF-8" "de_DE.UTF-8" "it_IT.UTF-8" "gl_ES.UTF-8" "pt_PT.UTF-8" "${LANG_PREDET}")

		# Configure languages
		# BUG CORREGIDO: locale -a devuelve formato "es_ES.utf8" (minúsculas, sin guion),
		# por eso el grep nunca hacía match y se regeneraban los locales siempre.
		# Ahora se normaliza el nombre para comparar correctamente con la salida de locale -a.

		for idioma in "${idiomas[@]}"; do
			idioma_normalizado=$(echo "$idioma" | tr '[:upper:]' '[:lower:]' | sed 's/\.utf-8/.utf8/')
			if ! locale -a | grep -qi "^${idioma_normalizado}$"; then
				locale-gen "$idioma"
				echo "Configuración de $idioma completa."
			fi
		done
    
		# Set the default language

		update-locale LANG="${LANG_PREDET}"
    
		touch /opt/createmaster/verif/ok-lang
    
	fi
}

function _verif_path() {

	# Check if the script is being used on a master distro.
	#
	# By default this function checks that the directory defined in DISTRO_PATH
	# exists. This acts as a safeguard to prevent running createmaster on a
	# regular user machine instead of the dedicated master system.
	#
	# MULTI-DISTRO USAGE:
	# If your derivative does not use a dedicated user directory as the master
	# environment indicator, you can disable this check by adding the following
	# line to /opt/createmaster/var_distro:
	#
	#   DISTRO_VERIF_PATH="no"
	#
	# When set to "no", _verif_path returns immediately without any check,
	# allowing createmaster to run on any machine regardless of DISTRO_PATH.
	# When omitted or set to any other value, the check is enforced (default).

	if [[ "${DISTRO_VERIF_PATH:-yes}" == "no" ]]; then
		return 0
	fi

    if [ ! -d "$DISTRO_PATH" ]; then
        echo "ERROR: Comando exclusivo para ser utilizado en ${DISTRO_NAME^} Master."
        exit 1
	fi
}
