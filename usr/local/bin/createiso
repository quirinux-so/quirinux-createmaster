#!/bin/bash

# ======================================================================
# File:          createiso
# Path:          /usr/local/bin/
# Author:        Charlie Martínez® <cmartinez@quirinux.org>
# License:       https://www.gnu.org/licenses/gpl-2.0.txt
# Purpose:       Create an ISO from a master distro
# Distribution:  Quirinux 2.x
# ======================================================================

#
# Copyright (c) 2019-2025 Charlie Martínez, all rights reserved.
# License: https://www.gnu.org/licenses/gpl-2.0.txt
# Authorized and unauthorized uses of the Quirinux trademark:
# See https://www.quirinux.org/aviso-legal
#

#
# This script was created for Quirinux 2.0 and is used to automate
# the creation of an ISO using the Penguin's Eggs utility
# by Piero Proietti, which customizes GRUB and Calamares through
# wardrobe.
#
# This script was initially made to work only with the "quirinux" wardrobe.
# If you are not using the "quirinux" wardrobe, for the _rev and _calamares
# functions to be effective, you will need to use the "quirinux" wardrobe
# or modify its structure following the "quirinux" wardrobe as an example.
#
# Copyright (c) 2019-2025 Charlie Martinez. All Rights Reserved.
# License: https://www.gnu.org/licenses/gpl-2.0.txt
# Permitted and unauthorized uses of the Quirinux trademark:
# See https://www.quirinux.org/aviso-legal

# ----------------------------------------------------------------------
# Test mode
# ----------------------------------------------------------------------

TEST_MODE=0
if [[ "$1" == "--test" ]]; then
    TEST_MODE=1
    echo "$(_msg TEST_ACTIVATED)"
    echo
fi

# ----------------------------------------------------------------------
# Variables
# ----------------------------------------------------------------------
	
source "/opt/createmaster/var_distro" # Distribution variables
source "/opt/createmaster/lang/lang_createiso" # Translations
source "/opt/createmaster/functions" # Global functions
	
FILE_QML="$DISTRO_PATH/.wardrobe/vendors/$DISTRO_NAME/theme/calamares/branding/show.qml"
DESKTOP_DIR=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop") # User desktop path (locale-independent)

# ----------------------------------------------------------------------
# Local functions
# ----------------------------------------------------------------------

function _rev() {

    local CURRENT_REV=0

    if grep -q "Rev\." "$FILE_QML"; then
        CURRENT_REV=$(grep -oP 'Rev\. \d+' "$FILE_QML" | head -n1 | awk '{print $2}')
        [[ "$CURRENT_REV" =~ ^[0-9]+$ ]] || CURRENT_REV=0
    fi

    echo "$(_msg CURRENT_REV) $CURRENT_REV"
    echo "$(_msg KEEP_REV)"
    read -r ANSWER

    if [[ "$ANSWER" =~ ^[sS]$ ]]; then
        REV="$CURRENT_REV"
    else
        echo "$(_msg NEW_REV)"
        read -r REV
        [[ "$REV" =~ ^[0-9]+$ ]] || REV=0
    fi

    if [[ "$REV" -gt 0 ]]; then
        CURRENT_DATE=$(date +"%d-%m-%Y")
    else
        CURRENT_DATE=""
    fi
}

# ----------------------------------------------------------------------

function _calamares() {

    local FILES=(
        "$DISTRO_PATH/.wardrobe/vendors/$DISTRO_NAME/theme/calamares/branding/show.qml"
        "/etc/calamares/branding/$DISTRO_NAME/show.qml"
    )

    local BASE_VERSION="<b>$(_msg LABEL_VERSION)</b> $DISTRO_VERSION ${DISTRO_RELEASE^^} $DISTRO_DATE_RELEASE"
    local NEW_VERSION

    if [[ "$REV" -gt 0 ]]; then
        NEW_VERSION="$BASE_VERSION | Rev. $REV [$CURRENT_DATE]"
    else
        NEW_VERSION="$BASE_VERSION"
    fi

    for ARCHIVO in "${FILES[@]}"; do
        [[ -f "$ARCHIVO" ]] || continue

        echo "$(_msg PROCESSING) $ARCHIVO"

        if [[ "$TEST_MODE" -eq 1 ]]; then
            echo "$(_msg SIMULATION_START)"
            sed \
                -e 's|[[:space:]]*\|[[:space:]]*Rev\. [0-9]\+ \[[^]]*\]||g' \
                -e "s|<h1>[^<]*</h1>|<h1>$DISTRO_NAME GNU/Linux $(_msg LABEL_VERSION) $DISTRO_VERSION</h1>|g" \
                -e "s|<b>$(_msg LABEL_VERSION):</b>[^<]*<br/><br/>|$NEW_VERSION <br/><br/>|g" \
                "$ARCHIVO"
            echo "$(_msg SIMULATION_END)"
        else
            sed -i 's|[[:space:]]*\|[[:space:]]*Rev\. [0-9]\+ \[[^]]*\]||g' "$ARCHIVO"

            sed -i \
                "s|<h1>[^<]*</h1>|<h1>$DISTRO_NAME GNU/Linux $(_msg LABEL_VERSION) $DISTRO_VERSION</h1>|g" \
                "$ARCHIVO"

            sed -i \
                "s|<b>$(_msg LABEL_VERSION):</b>[^<]*<br/><br/>|$NEW_VERSION <br/><br/>|g" \
                "$ARCHIVO"
        fi
    done
}

# ----------------------------------------------------------------------

function _eggsyaml() {

    local eggs_yaml="/etc/penguins-eggs.d/eggs.yaml"
    local latest_kernel

    latest_kernel=$(ls -1 /boot/vmlinuz-* | sort -V | tail -n1 | sed 's|/boot/vmlinuz-||')

    if [[ -z "$latest_kernel" ]]; then
        echo "$(_msg ERR_KERNEL)"
        exit 1
    fi

    if [[ "$TEST_MODE" -eq 1 ]]; then
        echo "$(_msg TEST_EGGS_YAML) $latest_kernel"
        return
    fi

    sed -i "s|^initrd_img: .*|initrd_img: /boot/initrd.img-$latest_kernel|" "$eggs_yaml"
    sed -i "s|^vmlinuz: .*|vmlinuz: /boot/vmlinuz-$latest_kernel|" "$eggs_yaml"
}

# ----------------------------------------------------------------------

function _createiso() {

    if [[ "$TEST_MODE" -eq 1 ]]; then
        echo "$(_msg TEST_EGGS_PRODUCE)"
        return
    fi

    if [[ "$1" == "-f" ]]; then
        eggs produce --theme "$DISTRO_NAME" --release -f -n
    else
        eggs produce --theme "$DISTRO_NAME" --release --pendrive -n
    fi
}

# ----------------------------------------------------------------------

function _isoname() {

    [[ "$TEST_MODE" -eq 1 ]] && return

    ORIGINAL_ISO=$(find /home/eggs/.mnt/ -type f -name "*.iso" | head -n 1)

    if [ -n "$ORIGINAL_ISO" ]; then
        ISO_NAME="${DISTRO_NAME}-${DISTRO_VERSION}-${DISTRO_RELEASE^}_x64"
        [[ "$REV" -gt 0 ]] && ISO_NAME="${ISO_NAME}_Rev${REV}"
        ISO_NAME="${ISO_NAME}.iso"
        mv "$ORIGINAL_ISO" "$DESKTOP_DIR/$ISO_NAME"
    fi
}

# ----------------------------------------------------------------------

function _md5sum() {	
	
    [[ "$TEST_MODE" -eq 1 ]] && return

    ISO_BASE="${ISO_NAME%.iso}"
    if [ -e "$DESKTOP_DIR/$ISO_NAME" ]; then  
        cd "$DESKTOP_DIR" || exit 1
        md5sum "$ISO_NAME" > "${ISO_BASE}.md5"
    fi
}

# ----------------------------------------------------------------------

function _bye() {
	
    if [[ "$TEST_MODE" -eq 1 ]]; then
        echo
        echo "$(_msg TEST_END)"
        return
    fi

    if [ -e "${ISO_BASE}.md5" ]; then
        echo "$(_msg ISO_DONE) $DESKTOP_DIR"
    fi
}

function _clean() {
	
	cleanmaster
	
}

# ======================================================================
# Function execution
# ======================================================================
_rootcheck		# Ensures the script is run as root
_internet		# Checks for active internet connection
_clean			# Cleans up the work environment before starting
_rev			# Prompts for and sets the revision number
_calamares		# Updates version info in the Calamares installer files
_eggsyaml		# Updates eggs.yaml with the latest kernel version
_createiso		# Runs eggs produce to generate the ISO image
_isoname		# Renames the generated ISO file with the distro naming convention
_md5sum			# Generates the MD5 checksum file for the ISO
_bye			# Displays the final success message		
